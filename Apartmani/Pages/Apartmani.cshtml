@page
@model Apartmani.Pages.ApartmaniModel
@{
    ViewData["Title"] = L["Apartmani"].Value;
    ViewData["Description"] = L["Istražite apartmane Tokić u Mastrinki na Čiovu."].Value;
}
<section class="page-heading wrap">
    <p class="eyebrow">@L["BORAVAK UZ MORE"]</p>
    <h1>@L["Naši apartmani"]</h1>
    <p class="lead">@L["Prostor za odmor, druženje i bezbrižne dane na Čiovu."]</p>
</section>
<section class="wrap section page-content">
    <div class="detail-layout">
        <div>
            @if (Model.Images.Any())
            {
                <img class="detail-image" src="@Model.Images[0].Path" alt="Apartmani Tokić" />
            }
            else
            {
                <img class="detail-image" src="~/img/apartmani/47.jpg" alt="Apartmani Tokić" />
            }
        </div>
        <div>
            <p class="eyebrow">@L["OSJEĆAJTE SE KAO KOD KUĆE"]</p>
            <h2>@L["Sve što vam je potrebno"]</h2>
            <p>@L["Svi apartmani imaju terasu, klima uređaj, satelitsku televiziju, Wi-Fi te opremljenu kuhinju s hladnjakom i aparatom za kavu. Gostima su na raspolaganju parking i zajednički zidani roštilj."]</p>
            <div class="detail-block">
                <h3>@L["Apartman 2 + 2"]</h3>
                <p>@L["Osam apartmana sa spavaćom sobom, dnevnim boravkom s ležajem za dvije osobe, kuhinjom, kupaonicom i terasom."]</p>
            </div>
            <div class="detail-block">
                <h3>@L["Apartman 6 + 2"]</h3>
                <p>@L["Veći apartman s tri spavaće sobe, dnevnim boravkom s ležajem za dvije osobe, kuhinjom, dvije kupaonice i terasom."]</p>
            </div>
            <a class="button" asp-page="/Contact">@L["Pošaljite upit"] →</a>
        </div>
    </div>
</section>
