@page
@model Apartmani.Pages.ContactModel
@{
    ViewData["Title"] = L["Kontakt"].Value;
    ViewData["Description"] = L["Kontaktirajte Apartmane Tokić u Mastrinki na otoku Čiovu."].Value;
}
<section class="page-heading wrap">
    <p class="eyebrow">@L["TU SMO ZA VAS"]</p>
    <h1>@L["Planirajmo vaš odmor"]</h1>
    <p class="lead">@L["Pošaljite nam upit ili nas nazovite. Rado ćemo odgovoriti na vaša pitanja."]</p>
</section>
<section class="section wrap page-content">
    <div class="contact-grid">
        <div>
            <h2>@L["Kontaktirajte nas"]</h2>
            <p>Put Sv. Križa 38<br />Mastrinka, otok Čiovo</p>
            <p><a href="tel:+385989364321">+385 98 936 4321</a><br /><a href="tel:+385989639127">+385 98 963 9127</a><br /><a href="tel:+38763335502">+387 63 335 502</a><br /><a href="mailto:apartman.tokic@gmail.com">apartman.tokic@gmail.com</a></p>
            <a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=Apartmani+Toki%C4%87+Mastrinka" target="_blank" rel="noopener">@L["Otvori kartu"] ↗</a>
        </div>
        <div class="form-panel">
            <h2>@L["Pošaljite poruku"]</h2>
            <form method="post">
                <div class="spam-trap" aria-hidden="true">
                    <label for="Website">@L["Ostavite ovo polje praznim"]</label>
                    <input id="Website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <div asp-validation-summary="All" class="validation">
                </div>
                <label for="Name">@L["Ime i prezime"]</label>
                <input id="Name" name="Name" maxlength="100" value="@Model.Name" required />
                <label for="Email">@L["E-mail adresa"]</label>
                <input id="Email" name="Email" maxlength="254" type="email" value="@Model.Email" required />
                <label for="Message">@L["Poruka"]</label>
                <textarea id="Message" name="Message" maxlength="5000" rows="6" required>@Model.Message</textarea>
                <p class="form-note">@L["Podatke koristimo za odgovor na vaš upit. Više u"] <a asp-page="/Privacy">@L["obavijesti o privatnosti"]</a>.</p>
                <button class="button" type="submit">@L["Pošaljite poruku"] →</button>
            </form>
        </div>
    </div>
</section>
