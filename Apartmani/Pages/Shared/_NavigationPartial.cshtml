@using Apartmani.Utility
<nav class="main-nav" aria-label="@L["Glavna navigacija"]">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">@L["Izbornik"] <span aria-hidden="true">☰</span></button>
    <ul id="main-menu" class="nav-links">
        <li>
            <a asp-area="" asp-page="/Index">@L["Naslovnica"]</a>
        </li>
        <li>
            <a asp-area="" asp-page="/Apartmani">@L["Apartmani"]</a>
        </li>
        <li>
            <a asp-area="" asp-page="/Gallery">@L["Galerija"]</a>
        </li>
        <li>
            <a asp-area="" asp-page="/Contact">@L["Kontakt"]</a>
        </li>
        @if (User.IsInRole(SD.AdminEndUser))
        {
            <partial name="_NavigationManagerPartial" />
        }
        <li class="language-switcher" aria-label="@L["Odaberite jezik"]">
            <span class="language-label">@L["Jezik"]:</span>
            @foreach (var language in new[] { "hr", "en", "de" })
            {
                <a href="@(Context.Request.PathBase)@(Context.Request.Path)?culture=@language"
                   lang="@language" hreflang="@language"
                   aria-current="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == language ? "true" : null)">@language.ToUpperInvariant()</a>
            }
        </li>
    </ul>
</nav>
