<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] | Apartmani Tokić</title>
        <meta name="description" content="@ViewData["Description"]" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <a class="skip-link" href="#main">@L["Prijeđi na sadržaj"]</a>
        <header class="site-header">
            <div class="wrap header-inner">
                <a class="brand" asp-area="" asp-page="/Index"><span>APARTMANI</span>
                <strong>TOKIĆ</strong><i aria-hidden="true">∿</i></a>
                <partial name="_NavigationPartial" />
                <a class="button header-cta" asp-area="" asp-page="/Contact">@L["Pošaljite upit"] <span aria-hidden="true">→</span></a>
            </div>
        </header>
        <main id="main">
            @RenderBody()
        </main>
        <footer class="site-footer">
            <div class="wrap footer-inner">
                <div>
                    <a class="footer-brand" asp-area="" asp-page="/Index">Apartmani Tokić</a>
                    <p>Put Sv. Križa 38 · Mastrinka, Čiovo</p>
                </div>
                <div>
                    <a href="tel:+385989364321">+385 98 936 4321</a><br /><a href="mailto:apartman.tokic@gmail.com">apartman.tokic@gmail.com</a>
                </div>
                <div>
                    <a asp-area="" asp-page="/Privacy">@L["Privatnost i kolačići"]</a>
                    <p>© @DateTime.Now.Year Apartmani Tokić</p>
                </div>
            </div>
        </footer>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @RenderSection("Scripts", required: false)
    </body>
</html>
